# Скопируйте в .env и впишите значения. Секреты не коммитятся (.env в .gitignore).

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Числовые ID, которым бот отвечает, через запятую (узнать свой — у @userinfobot)
TELEGRAM_ALLOWED_IDS=

# --- Claude ---
ANTHROPIC_API_KEY=
MODEL_STRONG=claude-opus-5-5
MODEL_CHEAP=claude-haiku-5-5

# --- Meta (Instagram / Facebook Ads) ---
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v27.0

# --- Приложение ---
DATABASE_PATH=data/target_ai.sqlite3
# Часовой пояс для отчётов, если не определился по рекламному аккаунту
REPORT_TZ=UTC
LOG_LEVEL=INFO
